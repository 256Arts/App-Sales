    "Add an App Store Connect account in App Sales on your iPhone. It syncs here through iCloud Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Füge auf deinem iPhone in App Sales einen App Store Connect Account hinzu. Er wird über den iCloud-Schlüsselbund hierher synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Añade una cuenta de App Store Connect en App Sales en tu iPhone. Se sincroniza aquí mediante el llavero de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoutez un compte App Store Connect dans App Sales sur votre iPhone. Il se synchronise ici via le trousseau iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iPhoneのApp SalesでApp Store Connectアカウントを追加してください。iCloudキーチェーンでここに同期されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请在你 iPhone 上的 App Sales 中添加 App Store Connect 账户。它会通过 iCloud 钥匙串同步到此处。"
          }
        }
      }
    },
    "An unknown error occurred. Please file a bug report." : {
