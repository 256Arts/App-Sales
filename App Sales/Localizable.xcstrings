    "You are not signed in to Google Analytics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du bist nicht bei Google Analytics angemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No has iniciado sesión en Google Analytics."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
