    "Reads the sign-in your terminal is already using, at ~/%@. App Sales keeps its own copy and never writes to the file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liest die Anmeldung, die dein Terminal bereits verwendet, unter ~/%@. App Sales behält eine eigene Kopie und schreibt nie in die Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lee el inicio de sesión que tu terminal ya está usando, en ~/%@. App Sales guarda su propia copia y nunca escribe en el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lit la connexion déjà utilisée par votre terminal, à ~/%@. App Sales conserve sa propre copie et n'écrit jamais dans le fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ターミナルが既に使用しているサインイン情報を ~/%@ から読み取ります。App Salesは独自のコピーを保持し、このファイルには書き込みません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "读取终端已在使用的登录信息，位于 ~/%@。App Sales 会保留自己的副本，绝不会写入该文件。"
          }
        }
