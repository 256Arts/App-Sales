    "Sign in to Claude or Codex in Accounts to see how much of each one's limits you have left, beside the day's sales." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Melde dich in Accounts bei Claude oder Codex an, um neben den Tagesverkäufen zu sehen, wie viel Limit dir noch bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inicia sesión en Claude o Codex en Cuentas para ver, junto a las ventas del día, cuánto te queda de cada límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Connectez-vous à Claude ou Codex dans Comptes pour voir, à côté des ventes du jour, combien de limites vous reste-t-il."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「アカウント」でClaudeまたはCodexにサインインすると、その日の売上の横に各アシスタントの残り上限が表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在“账户”中登录 Claude 或 Codex，即可在当天销售额旁看到各自还剩多少限额。"
          }
        }
      }
    },
    "Sign in to Claude or Codex in App Sales to see your limits here." : {
      "localizations" : {
