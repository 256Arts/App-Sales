    "Analytics reports need to be turned on once with an API key that has the Admin role. After that, a Sales and Reports key can read them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Analyseberichte müssen einmal mit einem API-Schlüssel mit der Rolle „Admin“ aktiviert werden. Danach kann ein Sales-and-Reports-Schlüssel sie lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los informes de análisis deben activarse una vez con una clave de API con el rol de administrador. Después, una clave de Sales and Reports puede leerlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les rapports d'analyse doivent être activés une fois avec une clé API ayant le rôle Admin. Ensuite, une clé Sales and Reports peut les lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "分析レポートは、管理者ロールを持つAPIキーで一度有効にする必要があります。その後は、SalesおよびReportsのキーで読み取れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "分析报告需要先用具有管理员角色的 API 密钥启用一次。之后，销售和报告密钥即可读取它们。"
          }
        }
      }
    },
