    "Opens %@ in your browser. App Sales asks only to read your limits — the sign-in is its own, and leaves the one your terminal uses alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet %@ in deinem Browser. App Sales bittet nur um Lesezugriff auf deine Limits — die Anmeldung ist eigenständig und lässt die deines Terminals unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Abre %@ en tu navegador. App Sales solo solicita leer tus límites: este inicio de sesión es propio y no afecta al que usa tu terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ouvre %@ dans votre navigateur. App Sales ne demande qu'à lire vos limites — cette connexion est indépendante et ne touche pas celle utilisée par votre terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ブラウザで%@を開きます。App Salesは使用量の読み取りのみを求めます。このサインインは独立しており、ターミナルが使用するものには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "在浏览器中打开%@。App Sales 仅请求读取你的限额——此登录是独立的，不会影响终端使用的登录。"
          }
        }
      }
    },
